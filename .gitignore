# Only project source files may be tracked. Everything else is ignored by default.
*
!.gitignore
!Package.swift
!README.md
!Sources/
!Sources/**/
!Sources/**/*.swift
!Tests/
!Tests/**/
!Tests/**/*.swift
!Scripts/
!Scripts/*.swift
!Scripts/*.sh
!Docs/
!Docs/Storage.md
!Docs/Validation.md
!Resources/
!Resources/Info.plist

# Vaults, backups, private credentials and generated output stay local.
**/vaults/
**/ui-vault/
**/staging/
**/*.hzn
**/*.horizonbackup
**/*.horizonbackup/**
**/header.json
**/state.json
**/preferences.json
**/.process-lock
**/.env*
**/*.pem
**/*.key
**/.DS_Store
/build/
/.build/
/work/
/Resources/Horizon.iconset/
/Resources/Horizon.icns
/Resources/Horizon-1024.png
